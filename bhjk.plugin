#!name = 薄荷健康会员解锁
#!desc = 薄荷健康解锁会员、AI 不限次、去开屏与运营位广告（适配 App 15.10.x），单脚本多接口
#!author = zxx
#!homepage = https://github.com/solezxx/Scripts
#!icon = https://one.boohee.cn/beauty/uploads/asserts/20200819114418/default_male_avatar.png
#!date = 2026-11-11

[Script]
# 会员状态 / AI 频次
http-response ^https?:\/\/api\.boohee\.com\/(app-interface\/.+\/user\/user_info|ai-interface\/.+\/frequency-limited) script-path=https://raw.githubusercontent.com/solezxx/Scripts/main/bhjk.js, requires-body=true, max-size=-1, timeout=10, tag=薄荷健康会员
# 开屏接口兜底：该接口目前恒返回空结构，仅兼容旧版本
http-response ^https?:\/\/status\.boohee\.com\/api\/v\d+\/app_square\/start_up script-path=https://raw.githubusercontent.com/solezxx/Scripts/main/bhjk.js, requires-body=true, max-size=-1, timeout=10, tag=薄荷健康开屏

[Rewrite]
# 运营位广告图（弹窗/首页 banner 取自 bj.boohee.cn/年/op/），返回 1×1 透明图
^https?:\/\/bj\.boohee\.cn\/\d{4}\/op\/ url reject-img

[Rule]
# 开屏由 AnyThink(TopOn) 广告 SDK 渲染，掐掉 SDK 域名即无开屏
DOMAIN-SUFFIX,anythinktech.com,REJECT
DOMAIN-SUFFIX,toponad.com,REJECT
DOMAIN-SUFFIX,toponad.net,REJECT

[MITM]
hostname = %APPEND% api.boohee.com, status.boohee.com, bj.boohee.cn
